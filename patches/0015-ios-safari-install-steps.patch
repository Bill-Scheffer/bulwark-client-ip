   useEffect(() => {
     if (localStorage.getItem(DISMISSED_KEY)) return;
 
+    if (isIosSafari()) {
+      // Signed out (or never signed in) hides it again: the sign-in page is where it would be in the way.
+      const show = isAuthenticated && !isStandalone();
+      setIosSteps(show ? (isIpad() ? "ipad" : "iphone") : null);
+      setShowPrompt(show);
+      return;
+    }
+
     const handler = (e: Event) => {
       e.preventDefault();
       setDeferredPrompt(e as BeforeInstallPromptEvent);
@@ -44,7 +81,7 @@ export function PWAInstallPrompt() {
     return () => {
       window.removeEventListener("beforeinstallprompt", handler);
     };
-  }, []);
+  }, [isAuthenticated]);
 
   useEffect(() => {
     promptVisible = showPrompt;
@@ -80,13 +117,70 @@ export function PWAInstallPrompt() {
     setShowPrompt(false);
   };
 
-  if (!showPrompt || !deferredPrompt) {
+  if (!showPrompt || (!deferredPrompt && !iosSteps)) {
     return null;
   }
 
   const logoSrc = withBasePath(appLogoLightUrl || faviconUrl);
   const darkLogoSrc = withBasePath(appLogoDarkUrl || faviconUrl);
 
+  if (iosSteps) {
+    // The first step's icon is the arrow, bouncing toward Safari's toolbar. On a phone the card sits above webmail's
+    // own tab bar (3.25rem and half the safe area), so it never covers it, and the arrow never lands on a tab.
+    const Arrow = iosSteps === "ipad" ? ArrowUp : ArrowDown;
+    return (
+      <div
+        role="dialog"
+        aria-label={t("title", { appName })}
+        className={`fixed z-50 inset-x-4 mx-auto max-w-sm ${iosSteps === "ipad" ? "top-4 sm:inset-x-auto sm:right-4" : "bottom-[calc(4rem+env(safe-area-inset-bottom)/2)]"}`}
+      >
+        <div className="bg-white dark:bg-neutral-900 rounded-lg shadow-lg border border-neutral-200 dark:border-neutral-800 p-4">
+          <div className="flex items-start justify-between mb-3">
+            <div>
+              <h3 className="font-semibold text-sm text-neutral-900 dark:text-white">{t("title", { appName })}</h3>
+              <p className="text-xs text-neutral-600 dark:text-neutral-400 mt-1">{t("ios_description")}</p>
+            </div>
+            <button
+              onClick={handleDismiss}
+              className="text-neutral-400 hover:text-neutral-600 dark:hover:text-neutral-300 transition-colors"
+              aria-label={t("dismiss_aria")}
+            >
+              <X className="w-4 h-4" />
