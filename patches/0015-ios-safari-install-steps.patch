+/**
+ * Safari on an iPhone or iPad: the one browser there that adds a web app to the Home Screen, and it never fires
+ * beforeinstallprompt, so there is no install button to offer. An iPad asking for the desktop site says "Macintosh";
+ * its touch screen gives it away. Chrome, Firefox, Edge and Opera on iOS name themselves.
+ */
+export function isIosSafari(nav: Navigator = navigator): boolean {
+  const ua = nav.userAgent;
+  const ios = /iPhone|iPad|iPod/.test(ua) || (/Macintosh/.test(ua) && nav.maxTouchPoints > 1);
+  return ios && /Safari\//.test(ua) && !/CriOS|FxiOS|EdgiOS|OPiOS|GSA\//.test(ua);
+}
+
+/** Already opened from the Home Screen, so already installed. */
+function isStandalone(): boolean {
+  return (
+    window.matchMedia?.("(display-mode: standalone)").matches === true ||
+    (navigator as Navigator & { standalone?: boolean }).standalone === true
+  );
+}
+
+/** An iPad's Safari keeps Share at the top right; an iPhone's toolbar is at the bottom. */
+function isIpad(nav: Navigator = navigator): boolean {
+  return /iPad/.test(nav.userAgent) || (/Macintosh/.test(nav.userAgent) && nav.maxTouchPoints > 1);
+}
+
 export function PWAInstallPrompt() {
   const [deferredPrompt, setDeferredPrompt] =
     useState<BeforeInstallPromptEvent | null>(null);
   const [showPrompt, setShowPrompt] = useState(false);
+  // iOS Safari: steps to follow, since there is no prompt to call.
