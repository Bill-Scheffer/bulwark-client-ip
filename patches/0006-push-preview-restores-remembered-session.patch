+/**
+ * Rebuild a slot's context from its remembered sign-in (the 30-day session
+ * cookie a "remember me" login keeps), and store it. The context cookie ends
+ * with the browser session, so a browser restarted in the background - a push
+ * waking a phone - comes back with the remembered sign-in but no context.
+ * Returns null when there is no remembered sign-in or it will not open.
+ */
+export function restoreStalwartAuthContextFromSession(
+  cookieStore: CookieStore,
+  slot: number,
+): StalwartAuthContext | null {
+  const token = cookieStore.get(sessionCookieName(slot))?.value;
+  if (!token) return null;
+  const credentials = decryptSession(token);
+  if (!credentials) return null;
+  const context = {
+    serverUrl: credentials.serverUrl,
+    username: credentials.username,
+    authHeader: `Basic ${Buffer.from(`${credentials.username}:${credentials.password}`).toString('base64')}`,
+  };
+  setStalwartAuthContextInStore(cookieStore, slot, context);
+  return context;
+}
+
 export async function setStalwartAuthContext(slot: number, context: StalwartAuthContext): Promise<void> {
   const cookieStore = await cookies();
   setStalwartAuthContextInStore(cookieStore, slot, context);
