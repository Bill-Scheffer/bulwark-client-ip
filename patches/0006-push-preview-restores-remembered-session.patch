+++ b/lib/__tests__/auth-context-restore.test.ts
@@ -0,0 +1,62 @@
+import { describe, it, expect, vi, beforeEach } from 'vitest';
+
+vi.mock('@/lib/auth/session-secret', () => ({
+  getSessionSecret: () => 'test-session-secret-at-least-32-characters-long',
+}));
+vi.mock('@/lib/logger', () => ({
+  logger: { warn: vi.fn(), error: vi.fn(), debug: vi.fn(), info: vi.fn() },
+}));
+vi.mock('@/lib/oauth/cookie-config', () => ({
+  getCookieOptions: () => ({ httpOnly: true, secure: true, sameSite: 'lax', path: '/', maxAge: 2592000 }),
+}));
+
+class FakeCookies {
+  store = new Map<string, string>();
+  get(name: string) {
+    const value = this.store.get(name);
+    return value === undefined ? undefined : { name, value };
+  }
+  set(name: string, value: string) {
+    this.store.set(name, value);
+  }
+  delete(name: string) {
+    this.store.delete(name);
+  }
+}
+
+describe('restoreStalwartAuthContextFromSession', () => {
+  let jar: FakeCookies;
+  beforeEach(() => {
+    jar = new FakeCookies();
+  });
+
+  it('rebuilds and stores the context from a remembered sign-in', async () => {
+    const { encryptSession } = await import('@/lib/auth/crypto');
+    const { restoreStalwartAuthContextFromSession, readStalwartAuthContextFromStore } = await import('@/lib/stalwart/auth-context');
+    jar.set('jmap_session_1', encryptSession('https://mail.example.com', 'me@example.com', 'pw'));
+
+    const context = restoreStalwartAuthContextFromSession(jar as never, 1);
+
+    const expected = {
+      serverUrl: 'https://mail.example.com',
+      username: 'me@example.com',
+      authHeader: `Basic ${Buffer.from('me@example.com:pw').toString('base64')}`,
+    };
+    expect(context).toEqual(expected);
+    // Stored, so the next request in this browser session needs no rebuild.
+    expect(readStalwartAuthContextFromStore(jar as never, 1)).toEqual(expected);
+  });
+
+  it('returns null, and stores nothing, without a remembered sign-in', async () => {
+    const { restoreStalwartAuthContextFromSession } = await import('@/lib/stalwart/auth-context');
+    expect(restoreStalwartAuthContextFromSession(jar as never, 0)).toBeNull();
+    expect(jar.store.size).toBe(0);
+  });
+
+  it('returns null, and stores nothing, for a remembered sign-in that will not open', async () => {
+    const { restoreStalwartAuthContextFromSession } = await import('@/lib/stalwart/auth-context');
+    jar.set('jmap_session', 'bm90LWEtc2Vzc2lvbi10b2tlbi1hdC1hbGwtcmVhbGx5LW5vdA==');
+    expect(restoreStalwartAuthContextFromSession(jar as never, 0)).toBeNull();
+    expect([...jar.store.keys()]).toEqual(['jmap_session']);
+  });
+});
