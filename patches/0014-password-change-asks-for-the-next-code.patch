+import { render, screen, fireEvent, waitFor, act } from '@testing-library/react';
+import { it, expect, vi, beforeEach } from 'vitest';
+import { AccountSecuritySettings } from '../account-security-settings';
+import { useAccountSecurityStore } from '@/stores/account-security-store';
+import { useAuthStore } from '@/stores/auth-store';
+
+// Patch 0014. Stalwart accepts a two-step code once, so after a password change the form asks for the NEXT code
+// to keep a two-step session signed in. Keys render as themselves.
+vi.mock('next-intl', () => ({
+  useTranslations: () => Object.assign((key: string) => key, { raw: (key: string) => key }),
+}));
+vi.mock('../settings-section', async (importOriginal) => ({
+  ...(await importOriginal<typeof import('../settings-section')>()),
+  SettingsSection: ({ children }: { children: React.ReactNode }) => <div>{children}</div>,
+}));
+vi.mock('@/lib/stalwart/jmap-passthrough', () => ({ stalwartJmap: vi.fn(async () => []), requireResult: () => ({}) }));
+
+type NextCode = (refused: boolean) => Promise<string | null>;
+let answered: Array<string | null>;
+let changePassword: ReturnType<typeof vi.fn>;
+
+beforeEach(() => {
+  answered = [];
+  // The store asks for the code after the change, once, and again when the first is refused.
+  changePassword = vi.fn(async (_c: string, _n: string, _o?: string, nextCode?: NextCode) => {
+    answered.push(await nextCode!(false));
+    if (answered[0] === '111111') answered.push(await nextCode!(true));
+  });
+  useAccountSecurityStore.setState({ isStalwart: true, isProbing: false, fetchAll: vi.fn(async () => {}), otpEnabled: true, changePassword } as never);
+  useAuthStore.setState({ isAuthenticated: true, authMode: 'oauth', client: {} as never });
+});
+
+const submitChange = () => {
+  const form = screen.getByText('password.submit').closest('form')!;
+  const inputs = form.querySelectorAll('input');
+  // current, code, new, confirm
+  fireEvent.change(inputs[0], { target: { value: 'old-password' } });
+  fireEvent.change(inputs[1], { target: { value: '123456' } });
+  fireEvent.change(inputs[2], { target: { value: 'new-password' } });
+  fireEvent.change(inputs[3], { target: { value: 'new-password' } });
+  fireEvent.submit(form);
+};
+const prompt = () => screen.queryByRole('form', { name: 'password.next_code_title' });
+
+it('asks for the next code after the change, and passes on what the user types', async () => {
+  render(<AccountSecuritySettings />);
+  expect(prompt()).toBeNull();
+  submitChange();
+  await waitFor(() => expect(prompt()).not.toBeNull());
+  expect(changePassword).toHaveBeenCalledWith('old-password', 'new-password', '123456', expect.any(Function));
+  expect(screen.queryByText('password.next_code_refused')).toBeNull();
+  fireEvent.change(prompt()!.querySelector('input')!, { target: { value: ' 654321 ' } });
+  fireEvent.submit(prompt()!);
+  await waitFor(() => expect(answered).toEqual(['654321']));
+  expect(prompt()).toBeNull();
+});
+
+it('says so when a code was refused, and asks again', async () => {
+  render(<AccountSecuritySettings />);
+  submitChange();
+  await waitFor(() => expect(prompt()).not.toBeNull());
+  fireEvent.change(prompt()!.querySelector('input')!, { target: { value: '111111' } });
+  fireEvent.submit(prompt()!);
+  await waitFor(() => expect(screen.queryByText('password.next_code_refused')).not.toBeNull());
+  fireEvent.change(prompt()!.querySelector('input')!, { target: { value: '222222' } });
+  fireEvent.submit(prompt()!);
+  await waitFor(() => expect(answered).toEqual(['111111', '222222']));
+});
+
+it('passes on null when the user signs out instead', async () => {
+  render(<AccountSecuritySettings />);
+  submitChange();
+  await waitFor(() => expect(prompt()).not.toBeNull());
+  fireEvent.click(screen.getByText('password.next_code_decline'));
+  await waitFor(() => expect(answered).toEqual([null]));
+});
+
+it('passes on null when the page goes away while it asks', async () => {
+  const { unmount } = render(<AccountSecuritySettings />);
+  submitChange();
+  await waitFor(() => expect(prompt()).not.toBeNull());
+  act(() => unmount());
+  await waitFor(() => expect(answered).toEqual([null]));
+});
+
+it('asks nothing when two-step is off', async () => {
+  useAccountSecurityStore.setState({ otpEnabled: false });
+  changePassword.mockImplementation(async () => {});
+  render(<AccountSecuritySettings />);
+  const form = screen.getByText('password.submit').closest('form')!;
+  const inputs = form.querySelectorAll('input');
+  fireEvent.change(inputs[0], { target: { value: 'old-password' } });
+  fireEvent.change(inputs[1], { target: { value: 'new-password' } });
+  fireEvent.change(inputs[2], { target: { value: 'new-password' } });
+  fireEvent.submit(form);
+  await waitFor(() => expect(changePassword).toHaveBeenCalledWith('old-password', 'new-password', undefined, undefined));
+  expect(prompt()).toBeNull();
+});
