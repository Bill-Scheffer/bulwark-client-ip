diff --git a/lib/shared-store/__tests__/postgres-store.test.ts b/lib/shared-store/__tests__/postgres-store.test.ts
new file mode 100644
index 000000000..9fc3bfc56
--- /dev/null
+++ b/lib/shared-store/__tests__/postgres-store.test.ts
@@ -0,0 +1,122 @@
+import { randomBytes } from 'node:crypto';
+import { Client } from 'pg';
+import { afterAll, describe, expect, it } from 'vitest';
+import { versionOf } from '../keys';
+import { createPostgresStore, unavailable } from '../postgres';
+import { StoreUnavailableError, type SharedStore } from '../types';
+import { runStoreContract } from './contract';
+
+/**
+ * MainThrive (patch 0016). The contract against a real PostgreSQL, as
+ * redis-store.test.ts runs it against Valkey. Runs only when
+ * IT_SHARED_STORE_PG=1, with the connection in the PG* variables, so the
+ * offline unit run skips it. Tables get a random prefix and are dropped after.
+ */
+const enabled = process.env.IT_SHARED_STORE_PG === '1';
+const tag = randomBytes(4).toString('hex');
+
+async function admin<T>(fn: (c: Client) => Promise<T>): Promise<T> {
+  const c = new Client({ ssl: process.env.PGSSLMODE === 'disable' ? false : undefined });
+  await c.connect();
+  try {
+    return await fn(c);
+  } finally {
+    await c.end();
+  }
+}
+
+async function dropTables(prefix: string): Promise<void> {
+  await admin(async (c) => {
+    const { rows } = await c.query<{ name: string }>(
+      "SELECT tablename AS name FROM pg_tables WHERE schemaname = current_schema() AND tablename LIKE $1", [`${prefix}%`]);
+    for (const { name } of rows) await c.query(`DROP TABLE IF EXISTS "${name}"`);
+  });
+}
+
+describe('postgres store: which errors mean unavailable', () => {
+  it.each([
+    ['a refused connection', Object.assign(new Error('connect ECONNREFUSED 10.0.0.1:5432'), { code: 'ECONNREFUSED' })],
+    ['a server shutting down', Object.assign(new Error('terminating connection due to administrator command'), { code: '57P01' })],
+    ['too many clients', Object.assign(new Error('sorry, too many clients already'), { code: '53300' })],
+    ['a lost connection', new Error('Connection terminated unexpectedly')],
+    ['a query that timed out', new Error('Query read timeout')],
+  ])('%s', (_label, error) => {
+    expect(() => unavailable(error)).toThrow(StoreUnavailableError);
+  });
+
+  it.each([
+    ['a syntax error', Object.assign(new Error('syntax error at or near "SELEC"'), { code: '42601' })],
+    ['a unique violation', Object.assign(new Error('duplicate key value'), { code: '23505' })],
+    ['a plain bug', new TypeError('x is not a function')],
+  ])('not %s', (_label, error) => {
+    expect(() => unavailable(error)).toThrow(error.message);
+    expect(() => unavailable(error)).not.toThrow(StoreUnavailableError);
+  });
+});
+
+if (!enabled) {
+  describe('shared store contract: postgres', () => {
+    it.skip('needs IT_SHARED_STORE_PG=1 and the PG* variables', () => {});
+  });
+} else {
+  const prefix = `bulwark_test_${tag}_`;
+  const opened: SharedStore[] = [];
+  runStoreContract({
+    name: `postgres (${prefix})`,
+    makeStores: (n) => {
+      const stores = Array.from({ length: n }, () => createPostgresStore({ tablePrefix: prefix, earlierSettingsTable: null }));
+      opened.push(...stores);
+      return stores;
+    },
+    cleanup: async () => {
+      await Promise.all(opened.map((s) => s.close()));
+      await dropTables(prefix);
+    },
+  });
+
+  describe('postgres store: the settings the earlier store kept', () => {
+    const carryPrefix = `bulwark_carry_${tag}_`;
+    const earlier = `bulwark_carry_${tag}_old`;
+    const stores: SharedStore[] = [];
+    afterAll(async () => {
+      await Promise.all(stores.map((s) => s.close()));
+      await dropTables(carryPrefix);
+    });
+
+    it('carries them over once, byte for byte, and keeps the old rows under another name', async () => {
+      const id = 'a'.repeat(64);
+      const blob = randomBytes(80);
+      await admin(async (c) => {
+        await c.query(`CREATE TABLE ${earlier} (key text PRIMARY KEY, blob bytea NOT NULL, updated_at timestamptz NOT NULL DEFAULT now())`);
+        await c.query(`INSERT INTO ${earlier} (key, blob) VALUES ($1, $2), ('not-a-settings-id', 'x')`, [id, blob]);
+      });
+      // Two replicas starting at once: one carries over, the other finds it done.
+      const [a, b] = [0, 1].map(() => createPostgresStore({ tablePrefix: carryPrefix, earlierSettingsTable: earlier }));
+      stores.push(a, b);
+      await Promise.all([a.ready(), b.ready()]);
+      const doc = await b.collection('settings', { local: { dir: () => '/nonexistent' } }).get(id);
+      expect(doc?.data.equals(blob)).toBe(true);
+      expect(doc?.version).toBe(versionOf(blob));
+      expect(await a.collection('settings', { local: { dir: () => '/nonexistent' } }).list()).toEqual([id]);
+      const tables = await admin(async (c) => (await c.query<{ old: string | null; kept: string | null }>(
+        'SELECT to_regclass($1)::text AS old, to_regclass($2)::text AS kept', [earlier, `${earlier}_before_1_21`])).rows[0]);
+      expect(tables).toEqual({ old: null, kept: `${earlier}_before_1_21` });
+      // A later start finds nothing to carry over, so a deleted settings document stays deleted.
+      await a.collection('settings', { local: { dir: () => '/nonexistent' } }).delete(id);
+      const c2 = createPostgresStore({ tablePrefix: carryPrefix, earlierSettingsTable: earlier });
+      stores.push(c2);
+      await c2.ready();
+      expect(await c2.collection('settings', { local: { dir: () => '/nonexistent' } }).get(id)).toBeNull();
+    });
+  });
+
+  describe('postgres store: an unreachable database', () => {
+    it('is StoreUnavailableError, never a fallback', async () => {
+      const store = createPostgresStore({ tablePrefix: prefix, earlierSettingsTable: null, pool: { host: '127.0.0.1', port: 1, connectionTimeoutMillis: 500 } });
+      await expect(store.kv.get('k')).rejects.toBeInstanceOf(StoreUnavailableError);
+      await expect(store.ping(2000)).rejects.toBeInstanceOf(StoreUnavailableError);
+      expect(store.status().connected).toBe(false);
+      await store.close();
+    });
+  });
+}
