+++ b/lib/__tests__/shared-store.test.ts
@@ -0,0 +1,243 @@
+// @vitest-environment node
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { createHash } from 'node:crypto';
+import { mkdtempSync, readdirSync, rmSync, writeFileSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import path from 'node:path';
+
+// SHARED_STORE=postgres: settings-sync blobs and pairing codes live in one database that every
+// instance shares. Each "instance" below is a fresh module graph (vi.resetModules) over the same
+// fake database, which is exactly what two pods are. The real SQL runs against a real Postgres in
+// scripts/e2e-shared-store.sh; here the fake answers our statements by their shape.
+
+vi.mock('@/lib/auth/session-secret', () => ({
+  getSessionSecret: () => 's'.repeat(64),
+  hasSessionSecret: () => true,
+}));
+vi.mock('@/lib/logger', () => ({
+  logger: { warn: () => {}, error: () => {}, info: () => {}, debug: () => {} },
+}));
+
+interface FakeDb {
+  down: boolean;
+  clock: number;
+  schema: number;
+  configs: unknown[];
+  settings: Map<string, Buffer>;
+  pairing: Map<string, { blob: string; expiresAt: number }>;
+}
+const db: FakeDb = { down: false, clock: 0, schema: 0, configs: [], settings: new Map(), pairing: new Map() };
+
+function answer(text: string, params: unknown[] = []): { rows: unknown[] } {
+  const sql = text.replace(/\s+/g, ' ').trim();
+  if (/^(BEGIN|COMMIT|ROLLBACK|SELECT pg_advisory_xact_lock)/.test(sql)) return { rows: [] };
+  if (sql.startsWith('CREATE TABLE IF NOT EXISTS bulwark_settings')) { db.schema++; return { rows: [] }; }
+  if (sql.startsWith('INSERT INTO bulwark_settings')) { db.settings.set(params[0] as string, params[1] as Buffer); return { rows: [] }; }
+  if (sql.startsWith('SELECT blob FROM bulwark_settings')) {
+    const blob = db.settings.get(params[0] as string);
+    return { rows: blob ? [{ blob }] : [] };
+  }
+  if (sql.startsWith('DELETE FROM bulwark_settings')) { db.settings.delete(params[0] as string); return { rows: [] }; }
+  if (sql === 'DELETE FROM bulwark_pairing WHERE expires_at <= now()') {
+    for (const [k, v] of db.pairing) if (v.expiresAt <= db.clock) db.pairing.delete(k);
+    return { rows: [] };
+  }
+  if (sql.startsWith('INSERT INTO bulwark_pairing')) {
+    db.pairing.set((params[0] as Buffer).toString('hex'), { blob: params[1] as string, expiresAt: db.clock + (params[2] as number) });
+    return { rows: [] };
+  }
+  if (sql.startsWith('DELETE FROM bulwark_pairing WHERE code_hash = $1 RETURNING')) {
+    const k = (params[0] as Buffer).toString('hex');
+    const rec = db.pairing.get(k);
+    db.pairing.delete(k);
+    return { rows: rec ? [{ blob: rec.blob, live: rec.expiresAt > db.clock }] : [] };
+  }
+  throw new Error(`fake db: unexpected statement: ${sql}`);
+}
+
+vi.mock('pg', () => ({
+  Pool: class {
+    constructor(config: unknown) { db.configs.push(config); }
+    on() {}
+    async connect() {
+      if (db.down) throw new Error('connect ECONNREFUSED 10.43.0.1:5432');
+      return { query: async (t: string, p?: unknown[]) => answer(t, p), release: () => {} };
+    }
+    async query(t: string, p?: unknown[]) {
+      if (db.down) throw new Error('connect ECONNREFUSED 10.43.0.1:5432');
+      return answer(t, p);
+    }
+    async end() {}
+  },
+}));
+
+/** A fresh instance: its own module graph, so nothing in-process is shared with the last one. */
+async function instance() {
+  vi.resetModules();
+  return {
+    settings: await import('@/lib/settings-sync'),
+    pairing: await import('@/lib/auth/pairing-store'),
+    store: await import('@/lib/server/shared-store'),
+  };
+}
+
+const SERVER = 'https://mail.example.org';
+const TOKENS = {
+  accessToken: 'access-token-value',
+  refreshToken: 'refresh-token-value',
+  expiresIn: 3600,
+  tokenEndpoint: 'https://mail.example.org/auth/token',
+  clientId: 'webmail',
+  serverUrl: SERVER,
+  serverId: null,
+};
+
+let dir: string;
+beforeEach(() => {
+  Object.assign(db, { down: false, clock: 0, schema: 0, configs: [] });
+  db.settings.clear();
+  db.pairing.clear();
+  dir = mkdtempSync(path.join(tmpdir(), 'settings-'));
+  vi.stubEnv('SETTINGS_DATA_DIR', dir);
+  vi.stubEnv('SHARED_STORE', 'postgres');
+  vi.stubEnv('PGSSLMODE', '');
+  vi.stubEnv('PGSSLROOTCERT', '');
+});
+afterEach(() => {
+  vi.unstubAllEnvs();
+  rmSync(dir, { recursive: true, force: true });
+});
+
+describe('settings, shared by every instance', () => {
+  it('a save on one instance loads on another, and a later save on the second wins on the first', async () => {
+    const a = await instance();
+    await a.settings.saveUserSettings('u@example.org', SERVER, { theme: 'dark' });
+    const b = await instance();
+    expect(await b.settings.loadUserSettings('u@example.org', SERVER)).toEqual({ theme: 'dark' });
+    await b.settings.saveUserSettings('u@example.org', SERVER, { theme: 'light' });
+    expect(await a.settings.loadUserSettings('u@example.org', SERVER)).toEqual({ theme: 'light' });
+  });
+
+  it('keeps the file format and name: the row is the encrypted blob under the file name, and no file is written', async () => {
+    const a = await instance();
+    await a.settings.saveUserSettings('u@example.org', SERVER, { signature: 'secret-signature' });
+    const key = createHash('sha256').update(`u@example.org:${SERVER}`).digest('hex');
+    expect([...db.settings.keys()]).toEqual([key]);
+    expect(db.settings.get(key)!.toString('latin1')).not.toContain('secret-signature');
+    expect(readdirSync(dir)).toEqual([]);
+    // The same bytes, as a file, load in file mode: a legacy file can be imported as-is.
+    writeFileSync(path.join(dir, `${key}.enc`), db.settings.get(key)!);
+    vi.stubEnv('SHARED_STORE', '');
+    const f = await instance();
+    expect(await f.settings.loadUserSettings('u@example.org', SERVER)).toEqual({ signature: 'secret-signature' });
+  });
+
+  it('a delete on one instance is gone on the other; accounts do not share a row', async () => {
+    const a = await instance();
+    await a.settings.saveUserSettings('u@example.org', SERVER, { theme: 'dark' });
+    await a.settings.saveUserSettings('v@example.org', SERVER, { theme: 'light' });
+    const b = await instance();
+    await b.settings.deleteUserSettings('u@example.org', SERVER);
+    expect(await a.settings.loadUserSettings('u@example.org', SERVER)).toBeNull();
+    expect(await a.settings.loadUserSettings('v@example.org', SERVER)).toEqual({ theme: 'light' });
+  });
+
+  it('fails closed: with the database down a save and a load throw, naming no internals, and nothing falls back to a file', async () => {
+    db.down = true;
+    const a = await instance();
+    await expect(a.settings.saveUserSettings('u@example.org', SERVER, { theme: 'dark' })).rejects.toThrow(/^Shared store unavailable$/);
+    await expect(a.settings.loadUserSettings('u@example.org', SERVER)).rejects.toThrow(/^Shared store unavailable$/);
+    await expect(a.settings.deleteUserSettings('u@example.org', SERVER)).rejects.toThrow(/^Shared store unavailable$/);
+    expect(readdirSync(dir)).toEqual([]);
+  });
+
+  it('a failed connection is not cached: once the database is back, the same instance works', async () => {
+    db.down = true;
+    const a = await instance();
+    await expect(a.settings.saveUserSettings('u@example.org', SERVER, { theme: 'dark' })).rejects.toThrow();
+    db.down = false;
+    await a.settings.saveUserSettings('u@example.org', SERVER, { theme: 'dark' });
+    expect(await a.settings.loadUserSettings('u@example.org', SERVER)).toEqual({ theme: 'dark' });
+    expect(db.schema).toBe(1);
+  });
+
+  it('without SHARED_STORE nothing changes: the file, and no connection at all', async () => {
+    vi.stubEnv('SHARED_STORE', '');
+    const a = await instance();
+    await a.settings.saveUserSettings('u@example.org', SERVER, { theme: 'dark' });
+    expect(readdirSync(dir)).toHaveLength(1);
+    expect(await a.settings.loadUserSettings('u@example.org', SERVER)).toEqual({ theme: 'dark' });
+    expect(db.configs).toEqual([]);
+    expect(db.settings.size).toBe(0);
+  });
+});
+
+describe('pairing codes, shared by every instance', () => {
+  it('a code minted on one instance redeems once on another, and never again on either', async () => {
+    const a = await instance();
+    const { code, expiresIn } = await a.pairing.createPairing(TOKENS);
+    expect(code).toMatch(/^[0-9a-f]{64}$/);
+    expect(expiresIn).toBe(120);
+    const b = await instance();
+    expect(await b.pairing.consumePairing(code)).toEqual(TOKENS);
+    expect(await b.pairing.consumePairing(code)).toBeNull();
+    expect(await a.pairing.consumePairing(code)).toBeNull();
+  });
+
+  it('stores the code only as its hash, and the tokens only encrypted', async () => {
+    const a = await instance();
+    const { code } = await a.pairing.createPairing(TOKENS);
+    const [[key, rec]] = [...db.pairing];
+    expect(key).toBe(createHash('sha256').update(code).digest('hex'));
+    expect(rec.blob).not.toContain(code);
+    expect(Buffer.from(rec.blob, 'base64').toString('latin1')).not.toContain('access-token-value');
+  });
+
+  it('an expired code is refused, and is swept by the next mint', async () => {
+    const a = await instance();
+    const { code: old } = await a.pairing.createPairing(TOKENS);
+    db.clock += 120_000;
+    expect(await a.pairing.consumePairing(old)).toBeNull();
+    const { code: older } = await a.pairing.createPairing(TOKENS);
+    db.clock += 120_001;
+    await a.pairing.createPairing(TOKENS);
+    expect(db.pairing.size).toBe(1);
+    expect(await a.pairing.consumePairing(older)).toBeNull();
+  });
+
+  it('an unknown code is refused', async () => {
+    const a = await instance();
+    expect(await a.pairing.consumePairing('0'.repeat(64))).toBeNull();
+  });
+
+  it('fails closed with the database down: neither a mint nor a redeem succeeds', async () => {
+    db.down = true;
+    const a = await instance();
+    await expect(a.pairing.createPairing(TOKENS)).rejects.toThrow(/^Shared store unavailable$/);
+    await expect(a.pairing.consumePairing('0'.repeat(64))).rejects.toThrow(/^Shared store unavailable$/);
+  });
+
+  it('without SHARED_STORE it is the in-process store, so another instance cannot redeem', async () => {
+    vi.stubEnv('SHARED_STORE', '');
+    const a = await instance();
+    const { code } = await a.pairing.createPairing(TOKENS);
+    const b = await instance();
+    expect(await b.pairing.consumePairing(code)).toBeNull();
+    expect(await a.pairing.consumePairing(code)).toEqual(TOKENS);
+    expect(db.configs).toEqual([]);
+  });
+});
+
+describe('the connection verifies TLS by default, against PGSSLROOTCERT when given, and turns it off only for PGSSLMODE=disable', () => {
+  it.each<[string, Record<string, string>, unknown]>([
+    ['default', {}, true],
+    ['a private CA', { PGSSLROOTCERT: 'ca.crt' }, { ca: 'CA-PEM' }],
+    ['disable', { PGSSLMODE: 'disable' }, false],
+  ])('%s', async (_label, env, ssl) => {
+    writeFileSync(path.join(dir, 'ca.crt'), 'CA-PEM');
+    for (const [k, v] of Object.entries(env)) vi.stubEnv(k, k === 'PGSSLROOTCERT' ? path.join(dir, v) : v);
+    const a = await instance();
+    await a.store.sharedStore();
+    expect(db.configs).toEqual([expect.objectContaining({ ssl })]);
+  });
+});
