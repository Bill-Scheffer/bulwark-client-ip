diff --git a/lib/server/shared-store.ts b/lib/server/shared-store.ts
new file mode 100644
index 0000000..c5d8ff4
--- /dev/null
+++ b/lib/server/shared-store.ts
@@ -0,0 +1,148 @@
+import { readFileSync } from 'node:fs';
+import { Pool, type PoolConfig } from 'pg';
+import { logger } from '@/lib/logger';
+
+// A store every instance shares, for the two things upstream keeps per instance: the settings-sync
+// blobs (lib/settings-sync.ts, otherwise files under data/settings) and the device-pairing codes
+// (lib/auth/pairing-store.ts, otherwise an in-process Map). With it, any number of instances behind
+// one load balancer agree on both; sessions are already stateless cookies under SESSION_SECRET.
+//
+// Opt-in: SHARED_STORE=postgres. The connection comes from the standard PG* variables (PGHOST,
+// PGPORT, PGDATABASE, PGUSER, PGPASSWORD), which `pg` reads itself. TLS is verified: against
+// PGSSLROOTCERT when set, else the system's CAs; PGSSLMODE=disable turns it off (tests only).
+//
+// It fails closed: with the store configured and unreachable, a settings save or a pairing answers
+// an error. It never falls back to the per-instance file or Map, where two instances would disagree.
+
+export function sharedStoreEnabled(): boolean {
+  return process.env.SHARED_STORE === 'postgres';
+}
+
+const SCHEMA = `
+CREATE TABLE IF NOT EXISTS bulwark_settings (
+  key        text PRIMARY KEY,
+  blob       bytea NOT NULL,
+  updated_at timestamptz NOT NULL DEFAULT now()
+);
+CREATE TABLE IF NOT EXISTS bulwark_pairing (
+  code_hash  bytea PRIMARY KEY,
+  blob       text NOT NULL,
+  expires_at timestamptz NOT NULL
+);`;
+
+// Any fixed key: it only serialises the two instances' CREATE TABLE IF NOT EXISTS, which can
+// otherwise race to a unique violation on the catalog when both start at once.
+const SCHEMA_LOCK = 4_111_406;
+
+let pool: Pool | null = null;
+let ready: Promise<Pool> | null = null;
+
+function poolConfig(): PoolConfig {
+  const mode = process.env.PGSSLMODE;
+  const ca = process.env.PGSSLROOTCERT;
+  return {
+    max: 4,
+    // Settings traffic is sparse: keep a connection long enough that a save rarely pays a new TLS + SCRAM handshake.
+    idleTimeoutMillis: 300_000,
+    connectionTimeoutMillis: 5_000,
+    query_timeout: 5_000,
+    ssl: mode === 'disable' ? false : ca ? { ca: readFileSync(ca, 'utf8') } : true,
+  };
+}
+
+async function open(): Promise<Pool> {
+  if (!pool) {
+    pool = new Pool(poolConfig());
+    // An idle client's error (the server restarted, a switchover) must not crash the process; the
+    // pool drops that client and the next query opens another.
+    pool.on('error', (err) => logger.warn('Shared store: idle connection lost', { error: err.message }));
+  }
+  const client = await pool.connect();
+  try {
+    await client.query('BEGIN');
+    await client.query('SELECT pg_advisory_xact_lock($1)', [SCHEMA_LOCK]);
+    await client.query(SCHEMA);
+    await client.query('COMMIT');
+  } catch (err) {
+    await client.query('ROLLBACK').catch(() => undefined);
+    throw err;
+  } finally {
+    client.release();
+  }
+  return pool;
+}
+
+/** The pool, with the schema in place. A failure is not cached: the next call tries again. */
+export function sharedStore(): Promise<Pool> {
+  ready ??= open().catch((err) => {
+    ready = null;
+    throw err;
+  });
+  return ready;
+}
+
+/** Runs `fn` on the store, logging the cause and throwing a message that names no internals. */
+async function withStore<T>(what: string, fn: (db: Pool) => Promise<T>): Promise<T> {
+  try {
+    return await fn(await sharedStore());
+  } catch (err) {
+    logger.error(`Shared store: ${what} failed`, { error: err instanceof Error ? err.message : 'Unknown error' });
+    throw new Error('Shared store unavailable');
+  }
+}
+
+export function putSettingsBlob(key: string, blob: Buffer): Promise<void> {
+  return withStore('settings save', async (db) => {
+    await db.query(
+      `INSERT INTO bulwark_settings (key, blob) VALUES ($1, $2)
+       ON CONFLICT (key) DO UPDATE SET blob = EXCLUDED.blob, updated_at = now()`,
+      [key, blob],
+    );
+  });
+}
+
+export function getSettingsBlob(key: string): Promise<Buffer | null> {
+  return withStore('settings load', async (db) => {
+    const { rows } = await db.query<{ blob: Buffer }>('SELECT blob FROM bulwark_settings WHERE key = $1', [key]);
+    return rows[0]?.blob ?? null;
+  });
+}
+
+export function deleteSettingsBlob(key: string): Promise<void> {
+  return withStore('settings delete', async (db) => {
+    await db.query('DELETE FROM bulwark_settings WHERE key = $1', [key]);
+  });
+}
+
+/** Stores a pairing record that expires `ttlMs` from now by the DATABASE's clock, and sweeps expired ones. */
+export function putPairing(codeHash: Buffer, blob: string, ttlMs: number): Promise<void> {
+  return withStore('pairing create', async (db) => {
+    await db.query('DELETE FROM bulwark_pairing WHERE expires_at <= now()');
+    await db.query(
+      `INSERT INTO bulwark_pairing (code_hash, blob, expires_at) VALUES ($1, $2, now() + $3 * interval '1 millisecond')`,
+      [codeHash, blob, ttlMs],
+    );
+  });
+}
+
+/** Removes the record and returns it if it had not expired. Single-use across every instance: one DELETE wins. */
+export function takePairing(codeHash: Buffer): Promise<string | null> {
+  return withStore('pairing redeem', async (db) => {
+    const { rows } = await db.query<{ blob: string; live: boolean }>(
+      'DELETE FROM bulwark_pairing WHERE code_hash = $1 RETURNING blob, expires_at > now() AS live',
+      [codeHash],
+    );
+    return rows[0]?.live ? rows[0].blob : null;
+  });
+}
+
+/** At start-up: connect and create the schema, so a misconfiguration is in the log at once, not at the first save. */
+export async function initSharedStore(): Promise<void> {
+  if (!sharedStoreEnabled()) return;
+  try {
+    await sharedStore();
+    console.info('Shared store: ready (postgres)');
+  } catch (err) {
+    console.error('Shared store: FAILED to connect or create its schema:', err instanceof Error ? err.message : err);
+  }
+}
