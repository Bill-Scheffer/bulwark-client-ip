diff --git a/lib/shared-store/postgres.ts b/lib/shared-store/postgres.ts
new file mode 100644
index 000000000..3e4b9ae71
--- /dev/null
+++ b/lib/shared-store/postgres.ts
@@ -0,0 +1,597 @@
+import { readFileSync } from 'node:fs';
+import { Pool, type PoolClient, type PoolConfig } from 'pg';
+import { isConfigReadOnly } from '@/lib/admin/paths';
+import { logger } from '@/lib/logger';
+import { assertDocId, assertKey, assertName, toBuffer, versionOf } from './keys';
+import { localCollection } from './local';
+import {
+  StoreUnavailableError,
+  isStoreUnavailableError,
+  type AppendLog,
+  type CollectionOptions,
+  type CounterStore,
+  type DocCollection,
+  type EpochStore,
+  type KvStore,
+  type LeaseStore,
+  type LogOptions,
+  type PutOptions,
+  type PutResult,
+  type ReplicaInfo,
+  type ReplicaRegistry,
+  type SharedStore,
+  type StoredDoc,
+} from './types';
+
+/**
+ * MainThrive (patch 0016): the shared store on PostgreSQL, a third backend
+ * beside local and redis, selected by SHARED_STORE=postgres. It keeps every
+ * piece of state upstream shares between replicas (#1066) in one database,
+ * which for MainThrive is mail-pg's `bulwark` database: durable and backed
+ * up, where a Redis-protocol store would hold settings in memory.
+ *
+ * Every check-then-write is one statement or one transaction, so it is atomic
+ * on the server, as the Lua scripts are for redis. Counter windows use the
+ * caller's clock, as there; expiry (kv, documents, leases) uses the
+ * database's, as Redis uses its own.
+ *
+ * The connection is the standard PG* variables (PGHOST, PGPORT, PGDATABASE,
+ * PGUSER, PGPASSWORD), which `pg` reads itself. TLS is verified: against
+ * PGSSLROOTCERT when set, else the system's CAs; PGSSLMODE=disable turns it
+ * off (tests only). Like redis it fails closed: an unreachable database is a
+ * StoreUnavailableError, never a fallback to local files.
+ *
+ * On first start it carries over the settings the earlier patch kept in
+ * `bulwark_settings` (same id, same bytes: both are sha256 of user:server and
+ * iv‖tag‖ciphertext under SESSION_SECRET), then renames that table to
+ * `bulwark_settings_before_1_21`, so the copy runs once and the old rows stay
+ * as they were.
+ */
+
+export function postgresStoreSelected(): boolean {
+  return process.env.SHARED_STORE?.trim().toLowerCase() === 'postgres';
+}
+
+export interface PostgresStoreOptions {
+  /** Prefix of every table, so tests can use their own. Default `bulwark_store_`. */
+  tablePrefix?: string;
+  /** Per-statement timeout (ms). Default 5000. */
+  queryTimeoutMs?: number;
+  /** Override the pool settings (tests). */
+  pool?: PoolConfig;
+  /** The earlier patch's settings table, carried over once. Default `bulwark_settings`; null skips it. */
+  earlierSettingsTable?: string | null;
+}
+
+// Unavailable: a network error (ECONNREFUSED, ETIMEDOUT, …), a connection the
+// server shut, refused or lost (SQLSTATE classes 08, 53, 57, 58), a
+// serialisation failure or deadlock, and pg's own timeouts and lost
+// connections, which carry no code. Anything else is a bug, rethrown.
+const UNAVAILABLE_CODE = /^(E[A-Z]+|08...|53...|57...|58...|40001|40P01)$/;
+const UNAVAILABLE_MESSAGE = /timeout|Connection terminated|connection error|Client has encountered a connection error/i;
+
+export function unavailable(error: unknown): never {
+  if (isStoreUnavailableError(error)) throw error;
+  const code = (error as { code?: unknown })?.code;
+  const message = (error as Error)?.message ?? '';
+  const known = typeof code === 'string' ? UNAVAILABLE_CODE.test(code) : UNAVAILABLE_MESSAGE.test(message);
+  if (!known) throw error;
+  throw new StoreUnavailableError(`The shared store is unavailable: ${message}`, { cause: error });
+}
+
+function schemaSql(t: (name: string) => string): string {
+  return `
+CREATE TABLE IF NOT EXISTS ${t('kv')} (
+  key        text PRIMARY KEY,
+  value      text NOT NULL,
+  expires_at timestamptz
+);
+CREATE TABLE IF NOT EXISTS ${t('counters')} (
+  key      text PRIMARY KEY,
+  n        bigint NOT NULL,
+  reset_at bigint NOT NULL
+);
+CREATE TABLE IF NOT EXISTS ${t('docs')} (
+  coll       text NOT NULL,
+  id         text NOT NULL,
+  data       bytea NOT NULL,
+  version    text NOT NULL,
+  expires_at timestamptz,
+  PRIMARY KEY (coll, id)
+);
+CREATE TABLE IF NOT EXISTS ${t('logs')} (
+  seq  bigserial PRIMARY KEY,
+  name text NOT NULL,
+  line text NOT NULL
+);
+CREATE INDEX IF NOT EXISTS ${t('logs_name')} ON ${t('logs')} (name, seq);
+CREATE TABLE IF NOT EXISTS ${t('leases')} (
+  name       text PRIMARY KEY,
+  holder     text NOT NULL,
+  expires_at timestamptz NOT NULL
+);
+CREATE TABLE IF NOT EXISTS ${t('epochs')} (
+  area text PRIMARY KEY,
+  n    bigint NOT NULL
+);
+CREATE TABLE IF NOT EXISTS ${t('replicas')} (
+  id           text PRIMARY KEY,
+  info         text NOT NULL,
+  last_seen_at bigint NOT NULL
+);`;
+}
+
+// Any fixed key: it serialises the replicas' CREATE TABLE IF NOT EXISTS and the
+// one-time carry-over, which would otherwise race when both start at once.
+const SCHEMA_LOCK = 4_111_442;
+const LIVE = '(expires_at IS NULL OR expires_at > now())';
+
+function poolConfig(options: PostgresStoreOptions): PoolConfig {
+  const mode = process.env.PGSSLMODE;
+  const ca = process.env.PGSSLROOTCERT;
+  return {
+    max: 4,
+    // Keep a connection long enough that a request rarely pays a new TLS + SCRAM handshake.
+    idleTimeoutMillis: 300_000,
+    connectionTimeoutMillis: 5_000,
+    query_timeout: options.queryTimeoutMs ?? 5_000,
+    // The same bound on the server: query_timeout only stops waiting, and a statement it gave up on would otherwise
+    // keep running there, holding its locks.
+    statement_timeout: options.queryTimeoutMs ?? 5_000,
+    // The CA is read at each new connection, not once: a mounted Secret is updated in place when CNPG renews its CA,
+    // and a pod that outlived the old one would otherwise refuse every new connection until restarted.
+    ssl: mode === 'disable' ? false : ca ? { get ca() { return readFileSync(ca, 'utf8'); } } : true,
+    ...options.pool,
+  };
+}
+
+export function createPostgresStore(options: PostgresStoreOptions = {}): SharedStore {
+  const prefix = options.tablePrefix ?? 'bulwark_store_';
+  if (!/^[a-z_][a-z0-9_]{0,40}$/.test(prefix)) throw new Error(`Invalid table prefix: ${prefix}`);
+  const t = (name: string) => `${prefix}${name}`;
+  const earlier = options.earlierSettingsTable === undefined ? 'bulwark_settings' : options.earlierSettingsTable;
+  if (earlier !== null && !/^[a-z_][a-z0-9_]{0,40}$/.test(earlier)) throw new Error(`Invalid table name: ${earlier}`);
+  const pool = new Pool(poolConfig(options));
+  // An idle client's error (the server restarted, a switchover) must not crash
+  // the process: the pool drops that client and the next query opens another.
+  pool.on('error', (err) => logger.warn('Shared store: idle connection lost', { error: err.message }));
+  let connected = false;
+
+  let schema: Promise<void> | null = null;
+  function ensureSchema(): Promise<void> {
+    schema ??= (async () => {
+      const client = await pool.connect();
+      try {
+        await client.query('BEGIN');
+        await client.query('SELECT pg_advisory_xact_lock($1)', [SCHEMA_LOCK]);
+        await client.query(schemaSql(t));
+        await carryOverEarlierSettings(client);
+        await client.query('COMMIT');
+      } catch (err) {
+        await client.query('ROLLBACK').catch(() => undefined);
+        throw err;
+      } finally {
+        client.release();
+      }
+    })().catch((err) => {
+      // Not cached: the next call tries again.
+      schema = null;
+      throw err;
+    });
+    return schema;
+  }
+
+  async function carryOverEarlierSettings(client: PoolClient): Promise<void> {
+    if (earlier === null) return;
+    const { rows: [old] } = await client.query<{ present: boolean }>('SELECT to_regclass($1) IS NOT NULL AS present', [earlier]);
+    if (!old?.present) return;
+    const { rows } = await client.query<{ key: string; blob: Buffer }>(`SELECT key, blob FROM ${earlier}`);
+    for (const row of rows) {
+      // An id that is not one settings-sync would make is left behind with the old table.
+      if (!/^[0-9a-f]{64}$/.test(row.key)) continue;
+      await client.query(
+        `INSERT INTO ${t('docs')} (coll, id, data, version) VALUES ('settings', $1, $2, $3) ON CONFLICT (coll, id) DO NOTHING`,
+        [row.key, row.blob, versionOf(row.blob)],
+      );
+    }
+    await client.query(`ALTER TABLE ${earlier} RENAME TO ${earlier}_before_1_21`);
+    logger.info('Shared store: carried over the settings the earlier store kept', { settings: rows.length });
+  }
+
+  async function q<R extends Record<string, unknown> = Record<string, unknown>>(sql: string, params: unknown[] = []) {
+    try {
+      await ensureSchema();
+      const result = await pool.query<R>(sql, params);
+      connected = true;
+      return result;
+    } catch (error) {
+      connected = false;
+      return unavailable(error);
+    }
+  }
+
+  async function tx<T>(fn: (client: PoolClient) => Promise<T>): Promise<T> {
+    let client: PoolClient | undefined;
+    try {
+      await ensureSchema();
+      client = await pool.connect();
+      await client.query('BEGIN');
+      const result = await fn(client);
+      await client.query('COMMIT');
+      connected = true;
+      return result;
+    } catch (error) {
+      if (client) await client.query('ROLLBACK').catch(() => undefined);
+      connected = false;
+      return unavailable(error);
+    } finally {
+      client?.release();
+    }
+  }
+
+  // ─── kv ──────────────────────────────────────────────────────────────────
+
+  async function kvGet(key: string): Promise<string | null> {
+    const { rows } = await q<{ value: string }>(`SELECT value FROM ${t('kv')} WHERE key = $1 AND ${LIVE}`, [key]);
+    return rows[0]?.value ?? null;
+  }
+
+  // Insert, or replace a row only when it has expired: "absent" as Redis sees it.
+  const kvInsertIfAbsent = (expires: string) => `INSERT INTO ${t('kv')} (key, value, expires_at) VALUES ($1, $2, ${expires})
+    ON CONFLICT (key) DO UPDATE SET value = EXCLUDED.value, expires_at = EXCLUDED.expires_at
+    WHERE ${t('kv')}.expires_at IS NOT NULL AND ${t('kv')}.expires_at <= now()`;
+  const ttlExpr = (param: string) => `CASE WHEN ${param}::bigint > 0 THEN now() + ${param}::bigint * interval '1 millisecond' END`;
+
+  const kv: KvStore = {
+    async get(key) {
+      assertKey(key);
+      return kvGet(key);
+    },
+    async set(key, value, opts = {}) {
+      assertKey(key);
+      const ttl = opts.ttlMs && opts.ttlMs > 0 ? Math.ceil(opts.ttlMs) : 0;
+      if (opts.ifAbsent) {
+        const { rowCount } = await q(kvInsertIfAbsent(ttlExpr('$3')), [key, value, ttl]);
+        return rowCount === 1;
+      }
+      await q(`INSERT INTO ${t('kv')} (key, value, expires_at) VALUES ($1, $2, ${ttlExpr('$3')})
+        ON CONFLICT (key) DO UPDATE SET value = EXCLUDED.value, expires_at = EXCLUDED.expires_at`, [key, value, ttl]);
+      return true;
+    },
+    async del(key) {
+      assertKey(key);
+      await q(`DELETE FROM ${t('kv')} WHERE key = $1`, [key]);
+    },
+    async take(key) {
+      assertKey(key);
+      const { rows } = await q<{ value: string; live: boolean }>(
+        `DELETE FROM ${t('kv')} WHERE key = $1 RETURNING value, ${LIVE} AS live`, [key]);
+      return rows[0]?.live ? rows[0].value : null;
+    },
+    async update(key, fn, opts = {}) {
+      assertKey(key);
+      const ttl = opts.ttlMs && opts.ttlMs > 0 ? Math.ceil(opts.ttlMs) : 0;
+      for (let attempt = 0; attempt < 20; attempt++) {
+        const current = await kvGet(key);
+        const next = fn(current);
+        if (next === undefined) return undefined;
+        let ok: boolean;
+        if (next === null) {
+          ok = current === null
+            || (await q(`DELETE FROM ${t('kv')} WHERE key = $1 AND value = $2 AND ${LIVE}`, [key, current])).rowCount === 1;
+        } else if (current === null) {
+          ok = (await q(kvInsertIfAbsent(ttlExpr('$3')), [key, next, ttl])).rowCount === 1;
+        } else {
+          // Without ttlMs the value keeps the expiry it had, as on redis.
+          ok = (await q(`UPDATE ${t('kv')} SET value = $3,
+              expires_at = CASE WHEN $4::bigint > 0 THEN now() + $4::bigint * interval '1 millisecond' ELSE expires_at END
+            WHERE key = $1 AND value = $2 AND ${LIVE}`, [key, current, next, ttl])).rowCount === 1;
+        }
+        if (ok) return next;
+        await backoff(attempt);
+      }
+      // Fail closed like an outage: the callers then answer 503 instead of 500.
+      throw new StoreUnavailableError(`Too many concurrent writes to ${key}`);
+    },
+  };
+
+  // ─── counters ────────────────────────────────────────────────────────────
+
+  const counters: CounterStore = {
+    async reserve(limits, now = Date.now()) {
+      limits.forEach((l) => assertKey(l.key));
+      if (limits.length === 0) return { ok: true, retryAfterMs: 0, counts: [], resetAts: [] };
+      const keys = [...new Set(limits.map((l) => l.key))].sort();
+      return tx(async (client) => {
+        // Rows first, in key order, so two reservations lock them in the same order.
+        await client.query(
+          `INSERT INTO ${t('counters')} (key, n, reset_at) SELECT k, 0, 0 FROM unnest($1::text[]) AS k ORDER BY k ON CONFLICT (key) DO NOTHING`,
+          [keys]);
+        const { rows } = await client.query<{ key: string; n: string; reset_at: string }>(
+          `SELECT key, n, reset_at FROM ${t('counters')} WHERE key = ANY($1::text[]) ORDER BY key FOR UPDATE`, [keys]);
+        const found = new Map(rows.map((r) => [r.key, { n: Number(r.n), r: Number(r.reset_at) }]));
+        const n: number[] = [];
+        const r: number[] = [];
+        let ok = true;
+        let retry = 0;
+        limits.forEach((l, i) => {
+          let { n: ni, r: ri } = found.get(l.key) ?? { n: 0, r: 0 };
+          if (ri <= now) { ni = 0; ri = 0; }
+          n[i] = ni;
+          r[i] = ri;
+          if (Number.isFinite(l.max) && ni >= l.max) {
+            ok = false;
+            retry = Math.max(retry, ri - now);
+          }
+        });
+        if (ok) {
+          for (let i = 0; i < limits.length; i++) {
+            if (r[i] === 0) r[i] = now + Math.ceil(limits[i].windowMs);
+            n[i] += 1;
+            await client.query(`UPDATE ${t('counters')} SET n = $2, reset_at = $3 WHERE key = $1`, [limits[i].key, n[i], r[i]]);
+          }
+        }
+        // Windows over for a minute (the slack Redis keeps them for) go, now and then.
+        if (Math.random() < 0.02) {
+          await client.query(`DELETE FROM ${t('counters')} WHERE reset_at < $1`, [now - 60_000]);
+        }
+        return { ok, retryAfterMs: retry, counts: n, resetAts: r };
+      });
+    },
+    async refund(entries, now = Date.now()) {
+      if (entries.length === 0) return;
+      entries.forEach((e) => assertKey(e.key));
+      for (const e of entries) {
+        await q(`UPDATE ${t('counters')} SET n = n - 1
+          WHERE key = $1 AND reset_at > $2 AND ($3::bigint = 0 OR reset_at = $3::bigint) AND n > 0`, [e.key, now, e.resetAt ?? 0]);
+      }
+    },
+    async hit(key, windowMs, now = Date.now()) {
+      const result = await counters.reserve([{ key, max: Infinity, windowMs }], now);
+      return { count: result.counts[0], resetAt: result.resetAts[0] };
+    },
+    async get(key, now = Date.now()) {
+      assertKey(key);
+      const { rows } = await q<{ n: string; reset_at: string }>(`SELECT n, reset_at FROM ${t('counters')} WHERE key = $1`, [key]);
+      const row = rows[0];
+      if (!row || Number(row.reset_at) <= now) return null;
+      return { count: Number(row.n), resetAt: Number(row.reset_at) };
+    },
+    async reset(key) {
+      assertKey(key);
+      await q(`DELETE FROM ${t('counters')} WHERE key = $1`, [key]);
+    },
+  };
+
+  // ─── documents ───────────────────────────────────────────────────────────
+
+  function collection(name: string, opts: CollectionOptions): DocCollection {
+    assertName(name);
+    // Read-only config comes from the mounted files on every replica.
+    if (opts.configDir && isConfigReadOnly()) return localCollection(name, opts);
+    const ttl = opts.ttlMs && opts.ttlMs > 0 ? Math.ceil(opts.ttlMs) : 0;
+
+    async function get(id: string): Promise<StoredDoc | null> {
+      assertDocId(id);
+      const { rows } = await q<{ data: Buffer; version: string }>(
+        `SELECT data, version FROM ${t('docs')} WHERE coll = $1 AND id = $2 AND ${LIVE}`, [name, id]);
+      return rows[0] ? { data: rows[0].data, version: rows[0].version } : null;
+    }
+
+    async function put(id: string, data: Buffer | string, putOpts: PutOptions = {}): Promise<PutResult> {
+      assertDocId(id);
+      const bytes = toBuffer(data);
+      const version = versionOf(bytes);
+      const params = [name, id, bytes, version, ttl];
+      let rowCount: number | null;
+      if (putOpts.ifVersion === undefined) {
+        ({ rowCount } = await q(`INSERT INTO ${t('docs')} (coll, id, data, version, expires_at) VALUES ($1, $2, $3, $4, ${ttlExpr('$5')})
+          ON CONFLICT (coll, id) DO UPDATE SET data = EXCLUDED.data, version = EXCLUDED.version, expires_at = EXCLUDED.expires_at`, params));
+      } else if (putOpts.ifVersion === null) {
+        ({ rowCount } = await q(`INSERT INTO ${t('docs')} (coll, id, data, version, expires_at) VALUES ($1, $2, $3, $4, ${ttlExpr('$5')})
+          ON CONFLICT (coll, id) DO UPDATE SET data = EXCLUDED.data, version = EXCLUDED.version, expires_at = EXCLUDED.expires_at
+          WHERE ${t('docs')}.expires_at IS NOT NULL AND ${t('docs')}.expires_at <= now()`, params));
+      } else {
+        ({ rowCount } = await q(`UPDATE ${t('docs')} SET data = $3, version = $4, expires_at = ${ttlExpr('$5')}
+          WHERE coll = $1 AND id = $2 AND version = $6 AND ${LIVE}`, [...params, putOpts.ifVersion]));
+      }
+      if (rowCount === 1) return { ok: true, version };
+      return { ok: false, current: await get(id) };
+    }
+
+    async function remove(id: string, putOpts: PutOptions = {}): Promise<boolean> {
+      assertDocId(id);
+      if (putOpts.ifVersion === undefined) {
+        await q(`DELETE FROM ${t('docs')} WHERE coll = $1 AND id = $2`, [name, id]);
+        return true;
+      }
+      if (putOpts.ifVersion === null) {
+        // Only when there is nothing there: then there is nothing to delete but an expired row.
+        if (await get(id)) return false;
+        await q(`DELETE FROM ${t('docs')} WHERE coll = $1 AND id = $2 AND NOT ${LIVE}`, [name, id]);
+        return true;
+      }
+      const { rowCount } = await q(`DELETE FROM ${t('docs')} WHERE coll = $1 AND id = $2 AND version = $3 AND ${LIVE}`,
+        [name, id, putOpts.ifVersion]);
+      return rowCount === 1;
+    }
+
+    return {
+      name,
+      get,
+      put,
+      async update(id, fn, updateOpts = {}) {
+        const retries = updateOpts.maxRetries ?? 10;
+        for (let attempt = 0; attempt <= retries; attempt++) {
+          const current = await get(id);
+          const next = fn(current?.data ?? null);
+          if (next === undefined) return { data: undefined, version: current?.version ?? null };
+          if (next === null) {
+            if (!current) return { data: null, version: null };
+            if (await remove(id, { ifVersion: current.version })) return { data: null, version: null };
+          } else {
+            const result = await put(id, next, { ifVersion: current?.version ?? null });
+            if (result.ok) return { data: toBuffer(next), version: result.version };
+          }
+          await backoff(attempt);
+        }
+        throw new StoreUnavailableError(`Too many concurrent writes to ${name}/${id}`);
+      },
+      delete: remove,
+      async list(listPrefix = '') {
+        if (ttl > 0) await q(`DELETE FROM ${t('docs')} WHERE coll = $1 AND NOT ${LIVE}`, [name]);
+        const { rows } = await q<{ id: string }>(
+          `SELECT id FROM ${t('docs')} WHERE coll = $1 AND left(id, length($2)) = $2 AND ${LIVE}`, [name, listPrefix]);
+        return rows.map((row) => row.id).sort();
+      },
+    };
+  }
+
+  // ─── log ─────────────────────────────────────────────────────────────────
+
+  // One writer's lines land in the order it wrote them, as on one Redis
+  // connection: the pool would otherwise run concurrent appends in any order.
+  const logQueues = new Map<string, Promise<unknown>>();
+  function inOrder<T>(name: string, task: () => Promise<T>): Promise<T> {
+    const run = (logQueues.get(name) ?? Promise.resolve()).catch(() => undefined).then(task);
+    logQueues.set(name, run);
+    return run;
+  }
+
+  function log(name: string, opts: LogOptions): AppendLog {
+    assertName(name);
+    const write = (lines: string[]) => inOrder(name, () => tx(async (client) => {
+      // Per log, across replicas: no other writer's line lands inside a batch.
+      await client.query('SELECT pg_advisory_xact_lock(hashtext($1))', [`${prefix}log:${name}`]);
+      await client.query(`INSERT INTO ${t('logs')} (name, line) SELECT $1, l FROM unnest($2::text[]) WITH ORDINALITY AS u(l, i) ORDER BY i`,
+        [name, lines.map((line) => line.replace(/[\r\n]+/g, ' '))]);
+      await client.query(`DELETE FROM ${t('logs')} WHERE name = $1 AND seq <= (
+        SELECT seq FROM ${t('logs')} WHERE name = $1 ORDER BY seq DESC OFFSET $2 LIMIT 1)`, [name, opts.maxEntries]);
+    }));
+    return {
+      async append(line) {
+        await write([line]);
+      },
+      async appendMany(lines) {
+        if (lines.length === 0) return;
+        await write(lines);
+      },
+      async clear() {
+        await q(`DELETE FROM ${t('logs')} WHERE name = $1`, [name]);
+      },
+      async readAll() {
+        const { rows } = await q<{ line: string }>(`SELECT line FROM ${t('logs')} WHERE name = $1 ORDER BY seq`, [name]);
+        return rows.map((row) => row.line);
+      },
+      async length() {
+        const { rows } = await q<{ n: string }>(`SELECT count(*) AS n FROM ${t('logs')} WHERE name = $1`, [name]);
+        return Number(rows[0]?.n ?? 0);
+      },
+    };
+  }
+
+  // ─── coordination ────────────────────────────────────────────────────────
+
+  const leases: LeaseStore = {
+    async acquire(name, holder, ttlMs) {
+      assertName(name);
+      const { rowCount } = await q(`INSERT INTO ${t('leases')} (name, holder, expires_at)
+          VALUES ($1, $2, now() + $3::bigint * interval '1 millisecond')
+        ON CONFLICT (name) DO UPDATE SET holder = EXCLUDED.holder, expires_at = EXCLUDED.expires_at
+          WHERE ${t('leases')}.holder = EXCLUDED.holder OR ${t('leases')}.expires_at <= now()`, [name, holder, Math.ceil(ttlMs)]);
+      return rowCount === 1;
+    },
+    async release(name, holder) {
+      assertName(name);
+      await q(`DELETE FROM ${t('leases')} WHERE name = $1 AND holder = $2`, [name, holder]);
+    },
+    async holder(name) {
+      assertName(name);
+      const { rows } = await q<{ holder: string }>(`SELECT holder FROM ${t('leases')} WHERE name = $1 AND expires_at > now()`, [name]);
+      return rows[0]?.holder ?? null;
+    },
+  };
+
+  const epochs: EpochStore = {
+    async bump(area) {
+      const { rows } = await q<{ n: string }>(`INSERT INTO ${t('epochs')} (area, n) VALUES ($1, 1)
+        ON CONFLICT (area) DO UPDATE SET n = ${t('epochs')}.n + 1 RETURNING n`, [area]);
+      return Number(rows[0].n);
+    },
+    async all() {
+      const { rows } = await q<{ area: string; n: string }>(`SELECT area, n FROM ${t('epochs')}`);
+      return Object.fromEntries(rows.map((row) => [row.area, Number(row.n)]));
+    },
+  };
+
+  const REPLICA_KEEP_MS = 10 * 60 * 1000;
+  const replicas: ReplicaRegistry = {
+    async beat(info) {
+      const now = Date.now();
+      await q(`INSERT INTO ${t('replicas')} (id, info, last_seen_at) VALUES ($1, $2, $3)
+        ON CONFLICT (id) DO UPDATE SET info = EXCLUDED.info, last_seen_at = EXCLUDED.last_seen_at`,
+        [info.id, JSON.stringify({ ...info, lastSeenAt: now }), now]);
+      await q(`DELETE FROM ${t('replicas')} WHERE last_seen_at < $1`, [now - REPLICA_KEEP_MS]);
+    },
+    async recent(withinMs) {
+      const { rows } = await q<{ info: string }>(`SELECT info FROM ${t('replicas')} WHERE last_seen_at >= $1`, [Date.now() - withinMs]);
+      return rows.flatMap((row) => {
+        try { return [JSON.parse(row.info) as ReplicaInfo]; } catch { return []; }
+      });
+    },
+  };
+
+  const location = `postgres://${process.env.PGUSER ?? ''}@${process.env.PGHOST ?? 'localhost'}/${process.env.PGDATABASE ?? ''}`;
+  let readyPromise: Promise<void> | null = null;
+
+  return {
+    mode: 'postgres',
+    kv,
+    counters,
+    collection,
+    log,
+    leases,
+    epochs,
+    replicas,
+    async ping(timeoutMs = 1000) {
+      let timer: NodeJS.Timeout | undefined;
+      try {
+        await Promise.race([
+          q('SELECT 1'),
+          new Promise<never>((_, reject) => {
+            timer = setTimeout(() => reject(new StoreUnavailableError('The shared store did not answer in time')), timeoutMs);
+          }),
+        ]);
+      } finally {
+        if (timer) clearTimeout(timer);
+      }
+    },
+    status() {
+      return { mode: 'postgres', location, connected };
+    },
+    ready() {
+      // Resolves once the schema is in place; until then it keeps trying, as a
+      // Redis client keeps reconnecting.
+      readyPromise ??= (async () => {
+        for (let attempt = 0; ; attempt++) {
+          try {
+            await ensureSchema();
+            connected = true;
+            return;
+          } catch {
+            await new Promise((resolve) => setTimeout(resolve, Math.min(250 * (attempt + 1), 2000)));
+          }
+        }
+      })();
+      return readyPromise;
+    },
+    async close() {
+      await pool.end();
+    },
+  };
+}
+
+function backoff(attempt: number): Promise<void> {
+  const ms = Math.min(5 + attempt * 10, 100) * (0.5 + Math.random());
+  return new Promise((resolve) => setTimeout(resolve, ms));
+}
