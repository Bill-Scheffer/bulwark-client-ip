+import { render } from '@testing-library/react';
+import { describe, it, expect, vi, beforeEach } from 'vitest';
+import { AccountSecuritySettings } from '../account-security-settings';
+import { useAccountSecurityStore } from '@/stores/account-security-store';
+import { useAuthStore } from '@/stores/auth-store';
+
+// A two-step sign-in is a token session (authMode 'oauth'). Upstream hid the
+// password, display-name and two-factor sections from it, so a two-step user
+// could not change their password or turn two-step off; Stalwart accepts all
+// three on the session's bearer token (measured on v0.16.25). It also showed
+// two sections for upstream's own mobile app and JMAP clients, which this
+// deployment does not offer.
+vi.mock('next-intl', () => ({
+  useTranslations: () => Object.assign((key: string) => key, { raw: (key: string) => key }),
+}));
+vi.mock('../settings-section', async (importOriginal) => ({
+  ...(await importOriginal<typeof import('../settings-section')>()),
+  SettingsSection: ({ children }: { children: React.ReactNode }) => <div>{children}</div>,
+}));
+vi.mock('@/lib/stalwart/jmap-passthrough', () => ({ stalwartJmap: vi.fn(async () => []), requireResult: () => ({}) }));
+
+const fetchAll = vi.fn(async () => {});
+
+beforeEach(() => {
+  fetchAll.mockClear();
+  useAccountSecurityStore.setState({ isStalwart: true, isProbing: false, fetchAll, otpEnabled: true });
+});
+
+describe.each(['oauth', 'basic'] as const)('a %s session', (authMode) => {
+  it('shows Change Password, Display Name and Two-Factor, and no upstream-app sections', () => {
+    useAuthStore.setState({ isAuthenticated: true, authMode, client: {} as never });
+    const { container } = render(<AccountSecuritySettings />);
+    const text = container.textContent ?? '';
+    expect(text).toContain('password.title');
+    expect(text).toContain('display_name.label');
+    expect(text).toContain('totp.section_title');
+    expect(text).not.toContain('email_client.');
+    expect(text).not.toContain('link_device.');
+  });
+});
