diff --git a/stores/__tests__/auth-store-token-password.test.ts b/stores/__tests__/auth-store-token-password.test.ts
new file mode 100644
index 0000000..b50a87d
--- /dev/null
+++ b/stores/__tests__/auth-store-token-password.test.ts
@@ -0,0 +1,137 @@
+import { beforeEach, expect, it, vi } from 'vitest';
+
+// Patch 0011. A two-step sign-in is a token session, and Stalwart revokes its
+// access and refresh tokens when the password changes (measured: 401 and 400
+// right after). keepTokenSessionThrough runs the change, then signs in again
+// with the new password and the confirming code, and holds token refreshes
+// until it has: a refresh spending the revoked token would sign the user out.
+vi.mock('@/lib/jmap/client', () => {
+  class JMAPClient {}
+  class RateLimitError extends Error {}
+  class RequestTimeoutError extends Error {}
+  return { JMAPClient, RateLimitError, RequestTimeoutError };
+});
+
+import { useAuthStore } from '@/stores/auth-store';
+import { useAccountStore } from '@/stores/account-store';
+
+const A = {
+  id: 'alice@mail.x.test', label: 'alice@x.test', serverUrl: 'https://mail.x.test', username: 'alice@x.test',
+  authMode: 'oauth' as 'oauth' | 'basic', rememberMe: true, cookieSlot: 2, displayName: 'alice@x.test', email: 'alice@x.test',
+  isConnected: true, hasError: false, lastLoginAt: 1, avatarColor: '#000', isDefault: true,
+};
+const updateAccessToken = vi.fn();
+const logout = vi.fn(async () => {});
+let calls: Array<{ url: string; method: string; body: string }> = [];
+let exchangeStatus = 200;
+let refreshStatus = 401;
+
+beforeEach(() => {
+  calls = [];
+  exchangeStatus = 200;
+  refreshStatus = 401;
+  updateAccessToken.mockReset();
+  logout.mockReset();
+  vi.stubGlobal('fetch', vi.fn(async (input: unknown, init?: RequestInit) => {
+    const url = String(input);
+    calls.push({ url, method: init?.method ?? 'GET', body: String(init?.body ?? '') });
+    if (url.includes('/api/auth/totp-token-exchange')) {
+      return exchangeStatus === 200
+        ? new Response(JSON.stringify({ access_token: 'new-at', expires_in: 3600, has_refresh_token: true }), { status: 200 })
+        : new Response(JSON.stringify({ error: 'invalid_credentials' }), { status: exchangeStatus });
+    }
+    // By default the revoked refresh token: the route answers 401, which signs the session out.
+    if (url.includes('/api/auth/token')) {
+      return refreshStatus === 200
+        ? new Response(JSON.stringify({ access_token: 'pre-at', expires_in: 3600 }), { status: 200 })
+        : new Response('{}', { status: refreshStatus });
+    }
+    return new Response('{}', { status: 200 });
+  }));
+});
+
+const signedIn = (authMode: 'oauth' | 'basic') => {
+  useAccountStore.setState({ accounts: [{ ...A, authMode }] as never, activeAccountId: A.id, defaultAccountId: A.id });
+  useAuthStore.setState({
+    isAuthenticated: true, activeAccountId: A.id, accessToken: 'revoked-at', logout,
+    client: { updateAccessToken } as never,
+  });
+};
+const exchanges = () => calls.filter((c) => c.url.includes('/api/auth/totp-token-exchange')).map((c) => JSON.parse(c.body));
+const refreshes = () => calls.filter((c) => c.url.includes('/api/auth/token?'));
+
+it('signs a token session in again with the new password and the confirming code', async () => {
+  signedIn('oauth');
+  const change = vi.fn(async () => {});
+  await useAuthStore.getState().keepTokenSessionThrough(change, 'new-pw', '123456');
+  expect(change).toHaveBeenCalledOnce();
+  expect(exchanges()).toEqual([expect.objectContaining({ serverUrl: A.serverUrl, username: A.username, password: 'new-pw', totp: '123456', slot: 2 })]);
+  expect(updateAccessToken).toHaveBeenCalledWith('new-at');
+  // The server-side helpers (the Security page's calls) authenticate with the new token too.
+  const context = calls.find((c) => c.url.includes('/api/auth/stalwart-context'));
+  expect(JSON.parse(context!.body)).toMatchObject({ authHeader: 'Bearer new-at', slot: 2 });
+  expect(useAuthStore.getState().accessToken).toBe('new-at');
+  expect(logout).not.toHaveBeenCalled();
+  // and the hold is released: the next refresh is a refresh of its own
+  refreshStatus = 200;
+  await useAuthStore.getState().refreshAccessToken();
+  expect(refreshes()).toHaveLength(1);
+});
+
+it('lets a refresh already running finish first, then holds the later ones', async () => {
+  signedIn('oauth');
+  refreshStatus = 200; // the old token is still good until the change is applied
+  const before = useAuthStore.getState().refreshAccessToken();
+  let during: Promise<string | null> | undefined;
+  const change = vi.fn(async () => {
+    // The earlier refresh ends while the change is in flight (its cleanup must not drop the hold) ...
+    await before;
+    refreshStatus = 401; // ... and from here on the old refresh token is revoked
+    during = useAuthStore.getState().refreshAccessToken();
+  });
+  await useAuthStore.getState().keepTokenSessionThrough(change, 'new-pw', '123456');
+  expect(await before).toBe('pre-at');
+  expect(await during).toBe('new-at');
+  expect(refreshes()).toHaveLength(1); // only the one that started before the change
+  expect(logout).not.toHaveBeenCalled();
+});
+
+it('makes a refresh asked for during the change wait for the new sign-in, not spend the revoked token', async () => {
+  signedIn('oauth');
+  let during: Promise<string | null> | undefined;
+  await useAuthStore.getState().keepTokenSessionThrough(async () => {
+    // A request that hit the revoked token (a push reconnect, a poll) asks for a refresh now.
+    during = useAuthStore.getState().refreshAccessToken();
+  }, 'new-pw', '123456');
+  expect(await during).toBe('new-at');
+  expect(refreshes()).toHaveLength(0);
+  expect(logout).not.toHaveBeenCalled();
+});
+
+it('ends the session as expired when the new sign-in is refused, rather than at the next request', async () => {
+  signedIn('oauth');
+  exchangeStatus = 401;
+  await useAuthStore.getState().keepTokenSessionThrough(async () => {}, 'new-pw', '000000');
+  expect(updateAccessToken).not.toHaveBeenCalled();
+  expect(logout).toHaveBeenCalledWith({ endProviderSession: false });
+});
+
+it('leaves the session alone and releases refreshes when the change itself is refused', async () => {
+  signedIn('oauth');
+  await expect(useAuthStore.getState().keepTokenSessionThrough(async () => {
+    throw new Error('Current secret is incorrect.');
+  }, 'new-pw', '123456')).rejects.toThrow('Current secret is incorrect.');
+  expect(exchanges()).toHaveLength(0);
+  expect(logout).not.toHaveBeenCalled();
+  await useAuthStore.getState().refreshAccessToken();
+  expect(refreshes()).toHaveLength(1);
+});
+
+it('just runs the change for a password (Basic) session', async () => {
+  signedIn('basic');
+  const change = vi.fn(async () => {});
+  await useAuthStore.getState().keepTokenSessionThrough(change, 'new-pw', '123456');
+  expect(change).toHaveBeenCalledOnce();
+  expect(exchanges()).toHaveLength(0);
+  expect(updateAccessToken).not.toHaveBeenCalled();
+});
