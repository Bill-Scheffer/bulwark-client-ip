+
+/**
+ * MainThrive (patch 0007): a token sign-in's context, rebuilt from its refresh
+ * token when the browser lost it. A password plus two-step sign-in runs on
+ * tokens; its refresh token, sign-in stamp and server cookie outlive a browser
+ * restart, but the context cookie ends with the browser session. A push that
+ * wakes a phone whose browser was killed in the background therefore finds no
+ * context, and readPushAuthContext rebuilds only a remembered Basic sign-in, so
+ * every notification after such a restart read "You have new mail".
+ *
+ * The same rules as renewPushAuthHeader decide whether it may renew here, and
+ * the same exchange renews, unless the access-token cache still holds a token
+ * with life left, which is used as it is. The rotated tokens are kept at once
+ * (the old refresh token is spent), and the context only once the session
+ * opened with the token, which also names the account. Null, and a warning naming the reason
+ * (never a value), when it can't.
+ */
+export async function restorePushContextFromRefreshToken(
+  cookieStore: CookieStore,
+  slot: number,
+  basePath: string | undefined,
+  openSession: (serverUrl: string, authHeader: string) => Promise<Response>,
+): Promise<StalwartAuthContext | null> {
+  if (IS_DESKTOP_BUILD) return null;
+  const refreshToken = cookieStore.get(refreshTokenCookieName(slot))?.value;
+  if (!refreshToken) return null;
+  const why = (reason: string, extra: Record<string, unknown> = {}) => {
+    logger.warn('push preview could not rebuild a token sign-in', { slot, reason, ...extra });
+    return null;
+  };
+  const age = await tokenSignedInAt(cookieStore, slot, refreshToken);
+  const remember = age?.stamp?.remember;
+  if (!age || remember === undefined) return why('no readable sign-in stamp');
+  const maxHours = await maxSessionHoursFor(age.stamp?.account);
+  if (isPastMaxAge(age.signedInAt, maxHours)) return why('past the maximum session length');
+  if (await limitsOnlyAPageEnforces()) return why('limits only a page enforces');
+  const bound = await refreshTokenServer(cookieStore, slot, refreshToken);
+  if (!bound) return why('the issuing server cannot be told');
+  // Loaded here, on the one path that needs it: the route's other paths never do.
+  const { DEFAULT_CLIENT_ID, getRequiredConfig } = await import('@/lib/oauth/token-exchange');
+  let serverUrl: string;
+  try {
+    serverUrl = getRequiredConfig(bound.serverId, bound.upstream ? { upstream: bound.upstream } : { fallbackClientId: DEFAULT_CLIENT_ID })
+      .serverUrl.replace(/\/+$/, '');
+  } catch {
+    return why('no server address for the token');
+  }
+  // An access token the cache still holds (it persists like the refresh token) is used as it is, as
+  // renewPushAuthHeader does: spending the refresh token for it would rotate it for nothing.
+  let accessToken = decodeCachedAccessToken(cookieStore.get(accessTokenCookieName(slot))?.value)?.accessToken;
+  if (!accessToken) {
+    const redemption = await redeemRefreshToken(refreshToken, bound.serverId, bound.upstream);
+    if (redemption.kind !== 'issued' || !redemption.tokens.access_token) {
+      return why('renewal failed', {
+        ...(redemption.kind === 'refused' ? { status: redemption.status } : {}),
+        ...(redemption.kind === 'unreachable' ? { error: redemption.message } : {}),
+      });
+    }
+    if (wasSignedOut(refreshToken)) return null;
+    ({ accessToken } = storeRenewedTokens(
+      cookieStore,
+      slot,
+      { ...redemption.tokens, access_token: redemption.tokens.access_token },
+      { remember, age, basePath, server: bound },
+    ));
+  }
+  const authHeader = `Bearer ${accessToken}`;
+  const res = await openSession(serverUrl, authHeader);
+  if (!res.ok) return why('the renewed token could not open the session', { status: res.status });
+  let username: unknown;
+  try {
+    username = ((await readJsonCapped(res, UPSTREAM_JSON_MAX_BYTES)) as { username?: unknown }).username;
+  } catch {
+    return why('the session could not be read');
+  }
+  if (typeof username !== 'string' || !username) return why('the session names no account');
+  const context: StalwartAuthContext = {
+    serverUrl,
+    username,
+    authHeader,
+    ...(age.stamp?.account && age.stamp.account !== username ? { accountName: age.stamp.account } : {}),
+  };
+  setStalwartAuthContextInStore(cookieStore, slot, context);
+  return context;
+}
