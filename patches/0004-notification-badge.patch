diff --git a/lib/__tests__/pwa-icon-badge.test.ts b/lib/__tests__/pwa-icon-badge.test.ts
new file mode 100644
index 0000000..20e76b2
--- /dev/null
+++ b/lib/__tests__/pwa-icon-badge.test.ts
@@ -0,0 +1,64 @@
+import { describe, it, expect, vi, beforeEach } from 'vitest';
+import sharp from 'sharp';
+
+vi.mock('next/server', () => ({
+  NextResponse: class {
+    status: number;
+    constructor(_body: unknown, init?: { status?: number }) {
+      this.status = init?.status ?? 200;
+    }
+  },
+}));
+
+let env: Record<string, { value: unknown; source: 'admin' | 'env' | 'default' }> = {};
+vi.mock('@/lib/admin/config-manager', () => ({
+  configManager: {
+    ensureLoaded: async () => {},
+    get: (_key: string, fallback?: unknown) => fallback,
+    getAllWithSources: () => env,
+  },
+}));
+
+const fetchBrandingAsset = vi.fn();
+vi.mock('@/lib/admin/branding-asset', () => ({
+  fetchBrandingAsset: (...args: unknown[]) => fetchBrandingAsset(...args),
+}));
+
+function setting(value: string) {
+  return { value, source: 'env' as const };
+}
+
+async function iconSource(purpose: string | null) {
+  const { GET } = await import('@/app/api/pwa-icon/[size]/route');
+  const req = {
+    headers: { get: () => 'mail.example.com' },
+    nextUrl: { searchParams: { get: (k: string) => (k === 'purpose' ? purpose : null) }, hostname: 'mail.example.com' },
+  };
+  const res = await GET(req as never, { params: Promise.resolve({ size: '192' }) });
+  expect(res.status).toBe(200);
+  return fetchBrandingAsset.mock.calls.at(-1)?.[0];
+}
+
+describe('pwa-icon ?purpose=badge', () => {
+  beforeEach(async () => {
+    fetchBrandingAsset.mockReset();
+    fetchBrandingAsset.mockResolvedValue(
+      await sharp({ create: { width: 8, height: 8, channels: 4, background: { r: 0, g: 0, b: 0, alpha: 0 } } }).png().toBuffer(),
+    );
+  });
+
+  it('serves the configured badge for the badge', async () => {
+    env = { pwaIconUrl: setting('/icon-a.webp'), pwaBadgeUrl: setting('/badge-a.webp') };
+    expect(await iconSource('badge')).toBe('/badge-a.webp');
+  });
+
+  it('serves the icon, not the badge, without ?purpose=badge', async () => {
+    env = { pwaIconUrl: setting('/icon-b.webp'), pwaBadgeUrl: setting('/badge-b.webp') };
+    expect(await iconSource(null)).toBe('/icon-b.webp');
+  });
+
+  it('falls back to the icon when no badge is configured', async () => {
+    env = { pwaIconUrl: setting('/icon-c.webp'), pwaBadgeUrl: { value: '', source: 'default' } };
+    expect(await iconSource('badge')).toBe('/icon-c.webp');
+  });
+});
