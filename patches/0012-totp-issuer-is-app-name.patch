+import { fireEvent, render } from '@testing-library/react';
+import { describe, it, expect, vi, beforeEach } from 'vitest';
+import * as OTPAuth from 'otpauth';
+import { AccountSecuritySettings, generateTotp } from '../account-security-settings';
+import { useAccountSecurityStore } from '@/stores/account-security-store';
+import { useAuthStore } from '@/stores/auth-store';
+
+// Patch 0012 (README, "The authenticator entry is named after this webmail"). The issuer in the otpauth URL is
+// what an authenticator app shows as the entry's name; upstream hardcodes 'Stalwart'.
+const config = { appName: 'MainThrive Mail' };
+vi.mock('@/hooks/use-config', () => ({ useConfig: () => config }));
+vi.mock('next-intl', () => ({
+  useTranslations: () => Object.assign((key: string) => key, { raw: (key: string) => key }),
+}));
+vi.mock('../settings-section', async (importOriginal) => ({
+  ...(await importOriginal<typeof import('../settings-section')>()),
+  SettingsSection: ({ children }: { children: React.ReactNode }) => <div>{children}</div>,
+}));
+vi.mock('@/lib/stalwart/jmap-passthrough', () => ({ stalwartJmap: vi.fn(async () => []), requireResult: () => ({}) }));
+
+beforeEach(() => {
+  config.appName = 'MainThrive Mail';
+  useAccountSecurityStore.setState({ isStalwart: true, isProbing: false, fetchAll: vi.fn(async () => {}), otpEnabled: false, isLoadingAuth: false });
+  useAuthStore.setState({ isAuthenticated: true, authMode: 'basic', client: { getUsername: () => 'alice@example.com' } as never });
+});
+
+/** Turn two-step on and decode the otpauth URL the setup shows, as an authenticator app would read it. */
+function enrol(): OTPAuth.TOTP {
+  const { container, getByRole } = render(<AccountSecuritySettings />);
+  fireEvent.click(getByRole('switch', { name: 'totp.label' }));
+  const shown = [...container.querySelectorAll('code')].map((c) => c.textContent ?? '').find((t) => t.startsWith('otpauth://'));
+  if (!shown) throw new Error('no otpauth URL was shown');
+  return OTPAuth.URI.parse(shown) as OTPAuth.TOTP;
+}
+
+describe('the TOTP enrolment', () => {
+  it('names the authenticator entry after the configured app name, not the mail server', () => {
+    const totp = enrol();
+    expect(totp.issuer).toBe('Stalwart Mail');
+    expect(totp.label).toBe('alice@example.com');
+  });
+
+  it('falls back to upstream\'s default app name, never "Stalwart", while the config is empty', () => {
+    config.appName = '';
+    expect(enrol().issuer).toBe('Webmail');
+  });
+
+  it('generateTotp puts the issuer it is given in the URL', () => {
+    const { url } = generateTotp('bob@example.com', 'Acme Mail');
+    expect(OTPAuth.URI.parse(url).issuer).toBe('Acme Mail');
+    expect(url).not.toContain('Stalwart');
+  });
+});
