@@ -0,0 +1,64 @@
+import { describe, it, expect, vi, beforeEach, afterEach } from 'vitest';
+
+vi.mock('@/lib/logger', () => ({
+  logger: { warn: vi.fn(), error: vi.fn(), debug: vi.fn(), info: vi.fn() },
+}));
+
+vi.mock('@/lib/oauth/token-exchange', () => ({
+  getTokenEndpoint: async () => 'https://idp.example.com/token',
+  buildOAuthParams: (params: Record<string, string>) => new URLSearchParams(params),
+  DEFAULT_CLIENT_ID: 'bulwark-webmail',
+}));
+
+const fetchMock = vi.fn();
+
+describe('requestTokenRefresh', () => {
+  beforeEach(() => {
+    vi.stubGlobal('fetch', fetchMock);
+    fetchMock.mockReset();
+  });
+  afterEach(() => vi.unstubAllGlobals());
+
+  function tokenResponse() {
+    return { ok: true, status: 200, json: async () => ({ access_token: 'fresh', expires_in: 60 }) };
+  }
+
+  it('spends a refresh token once for callers that arrive together', async () => {
+    const { requestTokenRefresh } = await import('@/lib/oauth/refresh-slot');
+    let release!: () => void;
+    fetchMock.mockImplementation(() => new Promise((resolve) => { release = () => resolve(tokenResponse()); }));
+
+    const both = Promise.all([requestTokenRefresh('rt1', null), requestTokenRefresh('rt1', null)]);
+    await vi.waitFor(() => expect(fetchMock).toHaveBeenCalled());
+    release();
+    const results = await both;
+
+    expect(fetchMock).toHaveBeenCalledTimes(1);
+    expect(results.map((r) => r.ok)).toEqual([true, true]);
+  });
+
+  it('exchanges again once the earlier exchange has settled', async () => {
+    const { requestTokenRefresh } = await import('@/lib/oauth/refresh-slot');
+    fetchMock.mockResolvedValue(tokenResponse());
+
+    await requestTokenRefresh('rt1', null);
+    await requestTokenRefresh('rt1', null);
+    expect(fetchMock).toHaveBeenCalledTimes(2);
+  });
+
+  it('does not share an exchange between different refresh tokens', async () => {
+    const { requestTokenRefresh } = await import('@/lib/oauth/refresh-slot');
+    fetchMock.mockResolvedValue(tokenResponse());
+
+    await Promise.all([requestTokenRefresh('rt1', null), requestTokenRefresh('rt2', null)]);
+    expect(fetchMock).toHaveBeenCalledTimes(2);
+  });
+
+  it('lets the next caller try again after a failed exchange', async () => {
+    const { requestTokenRefresh } = await import('@/lib/oauth/refresh-slot');
+    fetchMock.mockRejectedValueOnce(new Error('network down')).mockResolvedValue(tokenResponse());
+
+    await expect(requestTokenRefresh('rt1', null)).rejects.toThrow('network down');
+    await expect(requestTokenRefresh('rt1', null)).resolves.toMatchObject({ ok: true });
+  });
+});
